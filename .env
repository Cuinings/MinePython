# 本地开发配置 —— 启用交互式 API 文档 (/docs, /redoc, /openapi.json)
# 注意：DEBUG=true 会让全局异常处理器把内部异常信息返回给客户端，
# 仅限受信任的本地开发环境使用，生产环境请设为 false。
# 默认值设为 false（safe-by-default）：测试套件依赖生产默认行为（/docs 受控、
# 错误不泄露）；本地开发需要文档时临时改为 true 即可。
APP_DEBUG=false

# 工程名 / 站点名（动态自定义）：改这里即可给整站换名（前端标题+页头、API 文档、
# 后端服务标题都会跟着变），无需改代码。留空或不设则默认 MinePython。
# 也可登录后在「用户管理 → 站点设置」里由管理员直接改（会写回此文件）。
APP_NAME=云文件管理
