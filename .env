# File Server Configuration

# ---------- Branding (工程名 / 站点名，动态自定义) ----------
# The project display name shown in the web UI (page <title> + header), the
# API docs and backend service titles. Change it here to rebrand the whole app
# — no code edits needed. Defaults to "MinePython".
# APP_NAME=MinePython

HOST=0.0.0.0
PORT=8000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NICKNAME=管理员
MAX_UPLOAD_SIZE_MB=500
ALLOWED_EXTENSIONS=
# Comma-separated blocked extensions, e.g.: .exe,.sh,.bat
BLOCKED_EXTENSIONS=
TZ=Asia/Shanghai

# ---------- CORS ----------
# Comma-separated list of origins allowed to call the API (never "*" with
# credentials). Set this to your public UI origin(s) in production.
# CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---------- Database (ARCH-10) ----------
# Leave DATABASE_URL UNSET to use the local SQLite file (default) — local dev,
# CI and existing single-node deployments are unaffected.
# To scale out, point EVERY instance at the same Postgres so they share one
# schema and auth state:
#   DATABASE_URL=postgresql://user:pass@db-host:5432/minepython
# A bare `postgresql://` / `postgres://` URL is auto-normalized to the psycopg3
# (v3) sync driver in modules/user/database.py; pass `postgresql+psycopg://`
# explicitly to be unambiguous. SQLite-only behaviour (WAL, StaticPool,
# check_same_thread) is auto-disabled for non-sqlite URLs.

# ---------- JWT auth (ARCH-9) ----------
# Access tokens are short-lived, signature-verified JWTs (no DB lookup on the
# hot path). Refresh tokens are server-side hashed rows used only to renew.
# ALL instances MUST share the SAME JWT_SECRET, or they cannot verify each
# other's tokens. In dev a local `.jwt_secret` file is auto-generated; in
# production ALWAYS set it via the environment (or a secret store).
# JWT_SECRET=change-me-to-a-long-random-string
# JWT_ISSUER=minepython
# JWT_ACCESS_TTL_MINUTES=30      # access token lifetime (keep short — can't be revoked)
# JWT_REFRESH_TTL_DAYS=7         # effective "stay logged in" window
# DB pool sizing for the Postgres connection pool (ARCH-10):
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE=1800

# ---------- Session / cleanup tuning (ARCH-9 / ARCH-10) ----------
# Refresh-token sweep: delete expired refresh_tokens rows on this interval (s).
# REFRESH_TOKEN_CLEANUP_INTERVAL_SECONDS=3600
# Audit-log retention: purge rows older than N days (0 = keep forever).
# AUDIT_LOG_RETENTION_DAYS=90
# Permission cache: reload the in-memory role->permission map from the DB on
# this interval (s) so changes propagate across instances (0 = startup only).
# PERMISSION_CACHE_REFRESH_SECONDS=300

# ---------- Multi-instance upload rate limiting (ARCH-10) ----------
# Empty = in-memory single-process limiter (the single-instance default).
# Set to a Redis URL to count uploads shared across all instances:
# RATE_LIMIT_STORE=redis://redis-host:6379/0

# ---------- Refresh token hardening (optional) ----------
# When true, the refresh token is issued as an httpOnly + SameSite cookie
# instead of in the JSON body, shrinking the XSS blast radius. Enable behind
# HTTPS in production; keep off for local http dev.
# REFRESH_TOKEN_IN_COOKIE=false

# ---------- Login rate limiting ----------
# Per-username lock after N consecutive failures, for LOGIN_LOCK_SECONDS.
# MAX_LOGIN_FAILS=5
# LOGIN_LOCK_SECONDS=900                 # 15 min
# Per-IP throttle: N failures within the window returns 429 for that IP.
# LOGIN_IP_MAX_FAILS=20
# LOGIN_IP_WINDOW_SECONDS=300            # 5 min

# ---------- Batch download safety caps (guard against oversized ZIP / timeout) ----------
# MAX_BATCH_DOWNLOAD_FILES=500
# MAX_BATCH_DOWNLOAD_BYTES=2147483648   # 2 GB total uncompressed size

# ---------- Logging ----------
# Logs go to LOG_DIR/LOG_FILE_NAME as rotating JSON lines (Loki/ELK-ready),
# plus a human-readable console stream. Size-based rotation keeps N backups.
# LOG_DIR=logs
# LOG_FILE_NAME=app.log
# LOG_LEVEL=INFO            # DEBUG / INFO / WARNING / ERROR / CRITICAL
# LOG_MAX_BYTES=10485760    # ~10 MB per file before rotating
# LOG_BACKUPS=5             # number of rotated .1/.2/... backups to keep

# ---------- Debug / safe-by-default ----------
# Set to true ONLY in trusted development to enable /docs, /redoc, /openapi.json
# and verbose error strings. Defaults to false (production-safe): interactive
# API docs are blocked and internal exception messages are never returned to
# clients (ARCH-1 / R3).
# APP_DEBUG=false

APP_NAME=局域网服务
