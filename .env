# 本地开发配置
# DEBUG=false：生产安全默认，全局异常处理器不向客户端泄露内部异常信息。
# API_DOCS_ENABLED=true：把「是否暴露 API 文档」从 DEBUG 解耦——
# 即使 DEBUG=false，Swagger/ReDoc 文档门户 (/docs /redoc /openapi.json /api) 仍可访问。
APP_DEBUG=false
API_DOCS_ENABLED=true

# 工程名 / 站点名（动态自定义）：改这里即可给整站换名（前端标题+页头、API 文档、
# 后端服务标题都会跟着变），无需改代码。留空或不设则默认 MinePython。
# 也可登录后在「用户管理 → 站点设置」里由管理员直接改（会写回此文件）。
APP_NAME=局域网管理

MAX_UPLOAD_SIZE_MB=3000

MAX_USER_UPLOAD_BYTES=1024

UPLOAD_RATE_LIMIT=2
